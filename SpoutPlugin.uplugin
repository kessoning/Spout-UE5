{
	"FileVersion": 3,
	"Version": 6,
	"VersionName": "1.0.0",
	"FriendlyName": "Spout Plugin",
	"Description": "Windows-only Unreal Engine 5 plugin for sending and receiving GPU textures via Spout, bridging Unreal's Direct3D 12 renderer and Spout's Direct3D 11 shared textures.",
	"Category": "Rendering",
	"CreatedBy": "Kesson",
	"CreatedByURL": "https://kesson.io",
	"DocsURL": "https://github.com/kessoning/Spout-UE5",
	"SupportURL": "https://github.com/kessoning/Spout-UE5",
	"EnabledByDefault": true,
	"IsBetaVersion": false,
	"CanContainContent": true,
	"SupportedTargetPlatforms": [ "Win64" ],
	"Modules": [
		{
			"Name": "SpoutPluginShaders",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit",
			"PlatformAllowList": [ "Win64" ]
		},
		{
			"Name": "SpoutPlugin",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"PlatformAllowList": [ "Win64" ]
		}
	]
}
